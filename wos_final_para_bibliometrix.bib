@article{ WOS:001428071900016,
Author = {Sophia, Yacob and Roxy, Mathew Koll and Murtugudde, Raghu and Karipot,
   Anand and Sapkota, Amir and Dasgupta, Panini and Baliwant, Kalpana and
   Saunik, Sujata and Tiwari, Abhiyant and Chattopadhyay, Rajib and
