@article{ WOS:000434789700022,
Author = {Agarwal, Nikita and Koti, Shiva Reddy and Saran, Sameer and Kumar, A.
   Senthil},
Title = {Data mining techniques for predicting dengue outbreak in geospatial
   domain using weather parameters for New Delhi, India},
Journal = {CURRENT SCIENCE},
