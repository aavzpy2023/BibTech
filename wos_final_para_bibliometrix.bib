   Thomas, J. Joshua/AFN-8607-2022},
Funding-Acknowledgement = {KDU College (PG) Sdn Bhd},
Funding-Text = {KDU College (PG) Sdn Bhd has funded the work as an internal research
   grant scheme to the Department of Computing to conduct the computational
