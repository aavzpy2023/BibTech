@article{ WOS:000654769200004,
Author = {Medina, John Robert C. and Valdez, Faith Caitlyn G. and Daduya, Mae Ann
   Dl and Cruz, V, Rolando and Abrigo, Melvin R. and Molino, Jc Pal D. and
   Latorre, Angelica Anne E. and Co, Kim Carmela D. and Pinlac, V, Paul
   Adrian and Asaad, Abubakar S.},
Title = {TIME SERIES FORECASTING USING A SARMA MODEL FITTED ON DENGUE CASES
   (2010-2017): A POTENTIAL TOOL FOR AN EARLY WARNING SYSTEM IN QUEZON
   CITY, PHILIPPINES},
Journal = {SOUTHEAST ASIAN JOURNAL OF TROPICAL MEDICINE AND PUBLIC HEALTH},
Year = {2020},
Volume = {51},
Number = {1},
Pages = {31-46},
Abstract = {Public health surveillance is one of the key strategies being prescribed
   by the World Health Organization (WHO) for dengue prevention and control
   programs. Information generated from dengue surveillance are useful in
   the timely identification of outbreaks and epidemics to initiate prompt
   response. Time series modelling can be used in establishing an early
   warning system that can forecast a potential dengue outbreak. This study
   was done to assess the potential of a time series model in dengue
   forecasting. Using Box-Jenkins method, time series modeling was
   performed on the dengue surveillance data of the Quezon City
   Epidemiology and Surveillance Unit. A seasonal ARMA model that is fitted
   with the actual dengue cases from 2010 to 2016 was used in forecasting
   monthly dengue cases in 2017. Monthly time series data from 2010 to 2016
   observed inherent seasonality and stationarity. The model that
   demonstrated the best fit was ARMA(0,3)x(2,2)12, which can perform a
   static forecast with a mean absolute percentage error of 25.19\%. The
   SARMA model proved to be a potential tool for an early warning system,
   which will be helpful for local government officials, disease
   surveillance professionals, and program managers in public health
   decision making and in implementing timely and responsive actions.},
