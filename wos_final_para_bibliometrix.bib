Language = {English},
Affiliation = {Department of Biostatistics, Faculty of Public Health, Mahidol University, Bangkok, Thailand},
DOI = {10.14456/cast.2018.1},
ISSN = {25869396},
Keywords = {Dengue incidence; Forecasting model; SARIMA},
