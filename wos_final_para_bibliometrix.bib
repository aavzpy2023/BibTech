Language = {English},
Affiliation = {Erandi, KKWH (Corresponding Author), Univ Colombo, Res \& Dev Ctr Math Modelling, Dept Math, Colombo 03, Sri Lanka.
   Erandi, K. K. W. H.; Perera, S. S. N.; Mahasinghe, A. C., Univ Colombo, Res \& Dev Ctr Math Modelling, Dept Math, Colombo 03, Sri Lanka.},
DOI = {10.1504/IJDSDE.2021.120043},
